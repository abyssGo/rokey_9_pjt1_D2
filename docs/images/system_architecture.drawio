ml=1;fontFamily=Noto Sans CJK KR;fillColor=#eef0f3;strokeColor=none;fontSize=13.9;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="712.0" y="1517.3" width="260.0" height="22.0" as="geometry"/></mxCell><mxCell id="flow_node.col333" value="&lt;b&gt;처리 — 하는 일(번호 순)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fillColor=#eef0f3;strokeColor=none;fontSize=13.9;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1035.0" y="1517.3" width="600.0" height="22.0" as="geometry"/></mxCell><mxCell id="flow_node.col1020" value="&lt;b&gt;출력 — 내보내는 것&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fillColor=#eef0f3;strokeColor=none;fontSize=13.9;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1722.0" y="1517.3" width="290.0" height="22.0" as="geometry"/></mxCell><mxCell id="flow_node.grp0" value="&lt;b&gt;시작 — main() 한 번&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fillColor=#fafafa;strokeColor=#9aa5b1;align=left;verticalAlign=top;spacingLeft=9;spacingTop=3;fontSize=13.9;fontColor=#4a5666;" vertex="1" parent="1"><mxGeometry x="1028.0" y="1546.3" width="614.0" height="178.2" as="geometry"/></mxCell><mxCell id="flow_node.grp1" value="&lt;b&gt;메인 스레드 — 상태 머신 flow.run() · 두산 함수는 이 스레드에서만&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fillColor=#fafafa;strokeColor=#9aa5b1;align=left;verticalAlign=top;spacingLeft=9;spacingTop=3;fontSize=13.9;fontColor=#4a5666;" vertex="1" parent="1"><mxGeometry x="1028.0" y="1736.5" width="614.0" height="541.2" as="geometry"/></mxCell><mxCell id="flow_node.grp2" value="&lt;b&gt;통신 스레드 cc_io — 통신 노드 flow_node 를 spin&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fillColor=#fafafa;strokeColor=#9aa5b1;align=left;verticalAlign=top;spacingLeft=9;spacingTop=3;fontSize=13.9;fontColor=#4a5666;" vertex="1" parent="1"><mxGeometry x="1028.0" y="2289.7" width="614.0" height="143.4" as="geometry"/></mxCell><mxCell id="flow_node.in0" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b&gt;/flow/start · stop · resume · abort&lt;br&gt;(서비스 받음)&lt;/b&gt;&lt;div style=&quot;margin-top:3px;font-size:13.2px;color:#0b5fa5&quot;&gt;std_srvs/Trigger ← hmi_bridge · start 는&lt;br&gt;IDLE 일 때만 · resume 은 PAUSED(또는&lt;br&gt;이동 일시정지 중)일 때 · abort 는 PAUSED&lt;br&gt;이고 로봇 오류가 아닐 때&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=14.6;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="712.0" y="1546.3" width="260.0" height="119.4" as="geometry"/></mxCell><mxCell id="flow_node.in1" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b&gt;설정 cell.yaml + params.yaml&lt;/b&gt;&lt;div style=&quot;margin-top:3px;font-size:13.2px;color:#0b5fa5&quot;&gt;config.load() · 환경변수&lt;br&gt;PREWASH_USE_MOCK ·&lt;br&gt;PREWASH_VEL_SCALE(런치 인자) · flow&lt;br&gt;절 plan · policy · counts · state_pub_hz&lt;br&gt;2.0&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=14.6;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="712.0" y="1705.7" width="260.0" height="117.7" as="geometry"/></mxCell><mxCell id="flow_node.in2" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b&gt;cobot_common · cobot_api&lt;br&gt;(import)&lt;/b&gt;&lt;div style=&quot;margin-top:3px;font-size:13.2px;color:#0b5fa5&quot;&gt;공용 로봇 함수 cc.* · 실패 코드 · Result&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=14.6;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="712.0" y="1833.4" width="260.0" height="70.0" as="geometry"/></mxCell><mxCell id="flow_node.in3" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b&gt;기능 함수 13개 (load_features)&lt;/b&gt;&lt;div style=&quot;margin-top:3px;font-size:13.2px;color:#0b5fa5&quot;&gt;use_mock 에 따라 진짜 또는 가짜 모듈을&lt;br&gt;importlib 로 고름&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=14.6;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="712.0" y="1913.4" width="260.0" height="68.2" as="geometry"/></mxCell><mxCell id="flow_node.in4" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b&gt;/onrobot_joint_states (토픽 구독)&lt;/b&gt;&lt;div style=&quot;margin-top:3px;font-size:13.2px;color:#0b5fa5&quot;&gt;sensor_msgs/JointState ← RG2&lt;br&gt;드라이버 · 관절각 → 그리퍼 폭(mm) ·&lt;br&gt;effort → 힘&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=14.6;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="712.0" y="1991.6" width="260.0" height="84.7" as="geometry"/></mxCell><mxCell id="flow_node.out0" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b&gt;/flow/state (토픽 발행)&lt;/b&gt;&lt;div style=&quot;margin-top:3px;font-size:13.2px;color:#0b5fa5&quot;&gt;cobot_msgs/FlowState · 2 Hz · step · kind ·&lt;br&gt;zone_id · 완료 · 격리 수 · 소모품 수 ·&lt;br&gt;last_code · message&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=14.6;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1722.0" y="1546.3" width="290.0" height="84.7" as="geometry"/></mxCell><mxCell id="flow_node.out1" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b&gt;/flow/event (토픽 발행)&lt;/b&gt;&lt;div style=&quot;margin-top:3px;font-size:13.2px;color:#0b5fa5&quot;&gt;cobot_msgs/FlowEvent · 용기 1개마다 1건&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=14.6;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1722.0" y="1641.0" width="290.0" height="51.7" as="geometry"/></mxCell><mxCell id="flow_node.out2" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b&gt;/flow/weigh (토픽 발행)&lt;/b&gt;&lt;div style=&quot;margin-top:3px;font-size:13.2px;color:#0b5fa5&quot;&gt;cobot_msgs/WeighLive · 무게 표본마다 + 끝&lt;br&gt;1건 · 전부 가짜면 안 냄&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=14.6;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1722.0" y="1702.7" width="290.0" height="68.2" as="geometry"/></mxCell><mxCell id="flow_node.out3" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b&gt;두산 서비스 부름 — DSR_ROBOT2&lt;/b&gt;&lt;div style=&quot;margin-top:3px;font-size:13.2px;color:#0b5fa5&quot;&gt;노드 flow_node_dsr →&lt;br&gt;/dsr01/dsr_controller2/ motion · force ·&lt;br&gt;aux_control · system — 이동 · 힘 제어 · 툴 힘 ·&lt;br&gt;관절 · TCP 위치 · 로봇 상태&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=14.6;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1722.0" y="1781.0" width="290.0" height="101.2" as="geometry"/></mxCell><mxCell id="flow_node.out4" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b&gt;두산 서비스 부름 — 통신 노드 직접&lt;/b&gt;&lt;div style=&quot;margin-top:3px;font-size:13.2px;color:#0b5fa5&quot;&gt;motion/move_pause · move_resume ·&lt;br&gt;move_stop · system/set_robot_control ·&lt;br&gt;tool/get_current_tool · tcp/get_current_tcp&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=14.6;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1722.0" y="1892.2" width="290.0" height="84.7" as="geometry"/></mxCell><mxCell id="flow_node.out5" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b&gt;records.csv (파일 이어쓰기)&lt;/b&gt;&lt;div style=&quot;margin-top:3px;font-size:13.2px;color:#0b5fa5&quot;&gt;용기 1개 = 1줄 · 14칸&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=14.6;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1722.0" y="1986.9" width="290.0" height="51.7" as="geometry"/></mxCell><mxCell id="flow_node.out6" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b&gt;/onrobot/sendCommand (서비스 부름)&lt;/b&gt;&lt;div style=&quot;margin-top:3px;font-size:13.2px;color:#0b5fa5&quot;&gt;onrobot_rg_msgs/SetCommand · 문자열&lt;br&gt;&#x27;600&#x27;(폭 60.0 mm) · &#x27;o&#x27; 열기 · &#x27;c&#x27; 닫기 · &#x27;i&#x27; / &#x27;d&#x27;&lt;br&gt;힘&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fillColor=#f4f6f8;strokeColor=#9aa5b1;fontSize=14.6;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="1722.0" y="2112.9" width="290.0" height="84.7" as="geometry"/></mxCell><mxCell id="flow_node.st0" value="&lt;div style=&quot;line-height:1.25&quot;&gt;① config.load() → use_mock 정리 → cc.init(&#x27;flow_node&#x27;) — 실기면 두산 전용 노드&lt;br&gt;flow_node_dsr 를 만들고 드라이버 확인(get_robot_mode, 10 s) ·&lt;br&gt;set_robot_mode(AUTONOMOUS) · 통신 스레드 cc_io 시작&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=13.9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1035.0" y="1572.3" width="600.0" height="66.1" as="geometry"/></mxCell><mxCell id="flow_node.st1" value="&lt;div style=&quot;line-height:1.25&quot;&gt;② 문지기 preflight(실기만 · Virtual 이면 건너뜀): 컨트롤러의 툴 이름 &#x27;Tool Weight&#x27; · TCP 이름&lt;br&gt;&#x27;GripperDA_v1&#x27; 이 다르면 시작 거부(종료 코드 2) · 케이블 시작 점검: Fz 8번(0.7 s 간격) 흔들림 &amp;gt;&lt;br&gt;60 g 이면 경고만&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=13.9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1035.0" y="1648.4" width="600.0" height="66.1" as="geometry"/></mxCell><mxCell id="flow_node.st2" value="&lt;div style=&quot;line-height:1.25&quot;&gt;③ IDLE → start → 용기마다 PICK → WEIGH → SEAT → SOAP → WIPE → RINSE → RACK →&lt;br&gt;계획이 끝나면 DONE(1 s) → IDLE · 곁가지 PAUSED(사람 대기) · ISOLATE(격리 정리) · 계획&lt;br&gt;RET_B 그릇 2 → RET_C 컵 2&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=13.9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1035.0" y="1762.5" width="600.0" height="66.1" as="geometry"/></mxCell><mxCell id="flow_node.st3" value="&lt;div style=&quot;line-height:1.25&quot;&gt;④ 단계마다 기능 함수를 차례로 부름(보호 통로 call_fn): PICK f1.pick · WEIGH&lt;br&gt;f2.leftover_loop · SEAT f1.place · SOAP f1.tool → f3.soap · WIPE f3.wipe_bowl /&lt;br&gt;wipe_cup → f1.tool · RINSE f1.pick → f2.dip → f2.shake · RACK f1.rack_place →&lt;br&gt;f1.move_to&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=13.9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1035.0" y="1838.6" width="600.0" height="83.4" as="geometry"/></mxCell><mxCell id="flow_node.st4" value="&lt;div style=&quot;line-height:1.25&quot;&gt;⑤ 실패 정책(params flow.policy) — 실패 코드마다 next_zone(빈 구역 → 다음 구역) ·&lt;br&gt;isolate(격리) · pause(사람 대기) · retry:1-&amp;gt;isolate(곧게 위로 → 한 번 더 → 격리) · 함수 예외는&lt;br&gt;ROBOT_ERROR → 곧게 위로(safe_retreat) → PAUSED · 이동이 도중에 멈춰 위치를&lt;br&gt;모르면(MoveIncomplete) 후퇴 없이 힘 · 순응만 끔(force_off)&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=13.9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1035.0" y="1932.0" width="600.0" height="83.4" as="geometry"/></mxCell><mxCell id="flow_node.st5" value="&lt;div style=&quot;line-height:1.25&quot;&gt;⑥ 일시정지 · 재개 · 중단: stop 깃발 → 이동을 0.05 s 마다 확인하다 move_pause · resume →&lt;br&gt;move_resume · abort → cc.halt()(이동 중이면 move_stop) → 용기 처리 중이면 곧게 위로 →&lt;br&gt;툴 반납 · 격리 정리(⑤ 격리와 같은 길) · 용기 사이면 정리 없이 다음 용기&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=13.9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1035.0" y="2025.4" width="600.0" height="66.1" as="geometry"/></mxCell><mxCell id="flow_node.st6" value="&lt;div style=&quot;line-height:1.25&quot;&gt;⑦ 넛지 재개: 사람이 팔을 15 N 으로 0.15 s 밀면 1번 — 툴 힘을 0.2 s 마다 읽음 → 손 뗄 시간 1.5&lt;br&gt;s → STANDBY 확인(set_robot_control) · 툴 놓침 · 툴 집기 실패 · 로봇 오류 · 케이블 멈춤에서&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=13.9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1035.0" y="2101.5" width="600.0" height="48.7" as="geometry"/></mxCell><mxCell id="flow_node.st7" value="&lt;div style=&quot;line-height:1.25&quot;&gt;⑧ 케이블 감지(운전 중): 무게 표본 흔들림 &amp;gt; 80 g 이면 CableTightError → PAUSED → 케이블&lt;br&gt;정리 뒤 넛지 · 재개 → WEIGH 다시&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=13.9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1035.0" y="2160.2" width="600.0" height="48.7" as="geometry"/></mxCell><mxCell id="flow_node.st8" value="&lt;div style=&quot;line-height:1.25&quot;&gt;⑨ 기록 · 알림: 무게 표본을 읽을 때마다 /flow/weigh · 용기 1개 끝날 때마다 /flow/event 1건 +&lt;br&gt;records.csv 1줄(14칸) — 결과 DONE · ISOLATED · ERROR · SKIPPED&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=13.9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1035.0" y="2219.0" width="600.0" height="48.7" as="geometry"/></mxCell><mxCell id="flow_node.st9" value="&lt;div style=&quot;line-height:1.25&quot;&gt;⑩ 서비스 콜백은 깃발만 세움(로봇을 움직이지 않음): start · stop · resume · abort 깃발 + stop&lt;br&gt;은 cc.pause() · resume 은 cc.resume() · abort 는 cc.halt()&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=13.9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1035.0" y="2315.7" width="600.0" height="48.7" as="geometry"/></mxCell><mxCell id="flow_node.st10" value="&lt;div style=&quot;line-height:1.25&quot;&gt;⑪ /flow/state 타이머 2 Hz(지금 상태 스냅샷) · /onrobot_joint_states 콜백 — 그리퍼 폭 · 힘&lt;br&gt;저장&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK KR;fillColor=#ffffff;strokeColor=#b9c2cc;fontSize=13.9;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1035.0" y="2374.4" width="600.0" height="48.7" as="geometry"/></mxCell><mxCell id="flow_node.c0" style="edgeStyle=none;rounded=0;html=1;strokeColor=#1f4fd6;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=5;jumpStyle=arc;jumpSize=10;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.2463;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="flow_node.in0" target="flow_node.st9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="991.0" y="1606.0"/><mxPoint x="991.0" y="2327.7"/></Array></mxGeometry></mxCell><mxCell id="flow_node.c1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#e08a00;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=5;jumpStyle=arc;jumpSize=10;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.2724;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="flow_node.in1" target="flow_node.st0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1009.0" y="1764.6"/><mxPoint x="1009.0" y="1590.3"/></Array></mxGeometry></mxCell><mxCell id="flow_node.c2" style="edgeStyle=none;rounded=0;html=1;strokeColor=#e08a00;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=5;jumpStyle=arc;jumpSize=10;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.1816;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="flow_node.in1" target="flow_node.st2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1009.0" y="1764.6"/><mxPoint x="1009.0" y="1774.5"/></Array></mxGeometry></mxCell><mxCell id="flow_node.c3" style="edgeStyle=none;rounded=0;html=1;strokeColor=#e08a00;strokeWidth=1.3;endArrow=blockThin;endFill=1;endSize=5;jumpStyle=arc;jumpSize=10;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.1438;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="flow_node.in1" target="flow_node.st4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1009.0" y="1764.6"/><mxPoint x="1009.0" y="